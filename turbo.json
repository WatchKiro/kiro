{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*", "VITE_*", "TAURI_ENV_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "KIRO_MPV",
        "KIRO_SPIKE_LOG",
        "VITE_KIRO_SPIKE_AUTOPLAY",
        "VITE_KIRO_SPIKE_EXERCISE",
        "VITE_KIRO_SPIKE_SUBTITLE"
      ]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}

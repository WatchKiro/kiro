# Kiro website configuration. Copy to apps/web/.env.local for local development.
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time and are
# PUBLIC. Never put secrets in them. Variables without the prefix are only
# readable on the server (Server Components, route handlers, build).

# Canonical site URL, used for metadata (Open Graph, canonical links, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, GitHub links are shown in the header and footer, and the
# download buttons read the latest release from this repository's GitHub Releases.
# NEXT_PUBLIC_GITHUB_URL=https://github.com/<owner>/kiro

# Optional, server-only. Publish releases from a different repository than the
# source (for example a public "kiro-releases" repo while the code stays private).
# KIRO_RELEASES_REPO=<owner>/kiro-releases

# Optional, server-only. A GitHub token raises the API rate limit (60/h anonymous,
# 5000/h authenticated). Needs no scopes for a public repository. Note the releases
# repository itself must be public, or visitors cannot download the files.
# GITHUB_TOKEN=

{
  "name": "@kiro/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kiro desktop application (Tauri 2 + React).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri-dev.js",
    "dev:mpv": "tauri dev --features libmpv",
    "dev:renderer": "vite",
    "build": "vite build",
    "build:app": "tauri build",
    "build:mac": "scripts/build-macos.sh",
    "build:linux": "scripts/build-linux.sh",
    "build:windows": "node scripts/build-windows.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "tsx --tsconfig tsconfig.test.json --test \"src/**/*.test.ts\"",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@kiro/addon-sdk": "workspace:*",
    "@kiro/player-core": "workspace:*",
    "@kiro/ui": "workspace:*",
    "@kiro/utils": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@kiro/config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}

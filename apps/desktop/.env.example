# Kiro desktop renderer configuration. Copy to apps/desktop/.env.local.
#
# Only VITE_* and TAURI_ENV_* variables reach the renderer, and they are embedded
# in the shipped JavaScript bundle — treat them as PUBLIC. Never put secrets here.
# Secrets the desktop app needs in future belong in the Rust core (src-tauri),
# never in the webview.
#
# The desktop app works fully without the Kiro cloud API. No variables are
# required today.

# Reserved for optional cloud sync (not yet implemented). Adding it will also
# require allowing the origin in the CSP `connect-src` in src-tauri/tauri.conf.json.
# VITE_KIRO_API_URL=http://localhost:4000

# Set automatically by the Tauri CLI for device/mobile development. Rarely needed.
# TAURI_DEV_HOST=

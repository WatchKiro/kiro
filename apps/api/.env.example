# Kiro API — server-side configuration.
# Copy to apps/api/.env for local development. Everything here is server-only;
# none of it is ever sent to the website or desktop renderer.

# development | test | production. Production switches logs to JSON lines.
NODE_ENV=development

# Interface and port to bind. Use HOST=0.0.0.0 inside containers or behind a proxy.
HOST=127.0.0.1
PORT=4000

# debug | info | warn | error | silent
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API (exact origins, no paths).
#   http://localhost:3000   website (Next.js dev)
#   http://localhost:5173   desktop renderer (Vite dev)
#   tauri://localhost       packaged desktop app on macOS / Linux
#   http://tauri.localhost  packaged desktop app on Windows
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost,http://tauri.localhost

# Maximum time (ms) to wait for in-flight requests on SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

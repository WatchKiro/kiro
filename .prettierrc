{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cx"],
  "overrides": [
    {
      "files": "apps/web/**",
      "options": { "tailwindStylesheet": "./apps/web/src/styles/globals.css" }
    },
    {
      "files": ["apps/desktop/**", "packages/ui/**"],
      "options": { "tailwindStylesheet": "./apps/desktop/src/styles/globals.css" }
    }
  ]
}
